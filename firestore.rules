rules_version = '2';

// Reglas de seguridad de Firestore — MiniBarrio (prototipo académico).
//
// Modelo de roles: cada usuario autenticado tiene un documento en
// "usuarios/{uid}" con un campo "rol" ("cliente" | "propietario"). El
// negocio de un propietario vive en "negocios/{uid}" usando el MISMO uid
// como id de documento (1 propietario ⇄ 1 negocio en este prototipo).
//
// Despliega estas reglas con: firebase deploy --only firestore:rules

service cloud.firestore {
  match /databases/{database}/documents {

    function estaAutenticado() {
      return request.auth != null;
    }

    function esDueno(uid) {
      return estaAutenticado() && request.auth.uid == uid;
    }

    function rolDe(uid) {
      return get(/databases/$(database)/documents/usuarios/$(uid)).data.rol;
    }

    // Prueba de que un cliente tiene relación con un negocio, para crear la
    // marca "negocios/{negocioId}/clientes/{clienteId}" (ver más abajo): el
    // id de una cita de ese cliente en ese negocio, o de una reseña que ese
    // cliente le dejó. Ninguna de las dos la puede falsificar el negocio:
    // las citas y las reseñas solo las crea el propio cliente.
    function citaDelCliente(negocioId, clienteId) {
      let cita = get(/databases/$(database)/documents/citas/$(request.resource.data.citaId)).data;
      return cita.negocioId == negocioId && cita.clienteId == clienteId;
    }
    function resenaDelCliente(negocioId, clienteId) {
      return get(/databases/$(database)/documents/negocios/$(negocioId)/resenas/$(request.resource.data.resenaId)).data.clienteId == clienteId;
    }

    // Perfiles de usuario: cada quien lee y escribe solo el suyo. Excepción:
    // un propietario puede leer el perfil (nombre/correo/teléfono) de un
    // cliente SOLO si ese cliente tiene relación con su negocio — existe la
    // marca negocios/{su uid}/clientes/{uid del cliente}. Antes bastaba con
    // ser propietario, y como registrarse como negocio es libre, cualquiera
    // podía sacar los datos de contacto de todos los clientes (Ley 1581).
    match /usuarios/{uid} {
      allow read: if esDueno(uid)
                  || (estaAutenticado()
                      && resource.data.rol == 'cliente'
                      && exists(/databases/$(database)/documents/negocios/$(request.auth.uid)/clientes/$(uid)));
      allow create: if esDueno(uid)
                    && request.resource.data.rol in ['cliente', 'propietario'];
      allow update: if esDueno(uid)
                    && request.resource.data.rol == resource.data.rol; // el rol no se puede auto-cambiar
      allow delete: if false;

      // Negocios favoritos del cliente (panel de perfil): solo el propio
      // usuario puede leer y escribir su lista de favoritos.
      match /favoritos/{negocioId} {
        allow read, write: if esDueno(uid);
      }
    }

    // Negocios: lectura pública (portafolio visible sin sesión, RF-12);
    // escritura solo por su propio propietario.
    match /negocios/{negocioId} {
      allow read: if true;
      allow create: if esDueno(negocioId)
                    && rolDe(request.auth.uid) == 'propietario'
                    && request.resource.data.propietarioId == request.auth.uid;
      allow update, delete: if esDueno(negocioId);

      // Catálogo de servicios del negocio (RF-03/RF-04).
      match /servicios/{servicioId} {
        allow read: if true;
        allow write: if esDueno(negocioId);
      }

      // Reseñas (RF-10): cualquier cliente autenticado puede crear la suya;
      // solo puede editar/borrar la propia; el propietario no puede tocarlas.
      match /resenas/{resenaId} {
        allow read: if true;
        allow create: if estaAutenticado()
                      && rolDe(request.auth.uid) == 'cliente'
                      && request.resource.data.clienteId == request.auth.uid;
        allow update, delete: if estaAutenticado() && resource.data.clienteId == request.auth.uid;
      }

      // Clientes del negocio: marca que autoriza al propietario a leer el
      // perfil de ese cliente (regla de "usuarios"). La crea el propio
      // negocio desde su panel (src/perfilesClientes.js), pero solo con una
      // cita o reseña real de ese cliente como prueba. No se edita ni borra.
      match /clientes/{clienteId} {
        allow read: if esDueno(negocioId);
        allow create: if esDueno(negocioId)
                      && request.resource.data.keys().hasOnly(['citaId', 'resenaId', 'creadoEn'])
                      && (('citaId' in request.resource.data && citaDelCliente(negocioId, clienteId))
                          || ('resenaId' in request.resource.data && resenaDelCliente(negocioId, clienteId)));
        allow update, delete: if false;
      }

      // Visitas al perfil (contador de "Visitas al perfil" del panel): un
      // marcador por cliente. Solo se permite "create" (nunca "update"), así
      // que un mismo cliente no puede sumar más de una visita a un negocio
      // aunque vuelva a entrar varias veces. El propietario puede leer la
      // subcolección completa para contar sus visitas; cada cliente solo
      // puede leer su propio marcador.
      match /visitas/{clienteId} {
        allow read: if esDueno(clienteId) || esDueno(negocioId);
        allow create: if esDueno(clienteId) && rolDe(clienteId) == 'cliente';
        allow update, delete: if false;
      }
    }

    // Collection group: las reglas anidadas de arriba (negocios/{id}/servicios,
    // negocios/{id}/resenas) solo cubren la lectura de UN negocio a la vez.
    // ClientHome.jsx usa collectionGroup('servicios') y collectionGroup('resenas')
    // para traer calificaciones y precios de TODOS los negocios de una sola vez
    // (RF-05/RF-09) — Firestore exige una regla aparte con la sintaxis
    // recursiva {path=**} para autorizar ese tipo de consulta entre negocios.
    match /{path=**}/servicios/{servicioId} {
      allow read: if true;
    }
    match /{path=**}/resenas/{resenaId} {
      allow read: if true;
    }

    // Citas (RF-07/RF-08). Lectura: cualquier usuario autenticado puede leer
    // (necesario para calcular los turnos ya ocupados de un negocio antes de
    // reservar, ver NegocioDetalle.jsx); solo el cliente dueño de la cita o
    // el propietario del negocio pueden actualizarla.
    match /citas/{citaId} {
      allow read: if estaAutenticado();
      allow update: if estaAutenticado()
                    && (resource.data.clienteId == request.auth.uid
                        || resource.data.negocioId == request.auth.uid);
      allow create: if estaAutenticado()
                    && rolDe(request.auth.uid) == 'cliente'
                    && request.resource.data.clienteId == request.auth.uid;
      allow delete: if false;
    }
  }
}
