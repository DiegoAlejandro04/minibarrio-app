rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function estaAutenticado() {
      return request.auth != null;
    }

    function esDueno(uid) {
      return estaAutenticado() && request.auth.uid == uid;
    }

    function rolDe(uid) {
      return get(/databases/$(database)/documents/usuarios/$(uid)).data.rol;
    }

    function citaDelCliente(negocioId, clienteId) {
      let cita = get(/databases/$(database)/documents/citas/$(request.resource.data.citaId)).data;
      return cita.negocioId == negocioId && cita.clienteId == clienteId;
    }

    function resenaDelCliente(negocioId, clienteId) {
      return get(/databases/$(database)/documents/negocios/$(negocioId)/resenas/$(request.resource.data.resenaId)).data.clienteId == clienteId;
    }

    function citaTras(citaId) {
      return getAfter(/databases/$(database)/documents/citas/$(citaId)).data;
    }

    function idTurno(fechaHora) {
      return string(fechaHora.toMillis());
    }

    // Id del turno de una cita: con equipo lleva la persona que atiende
    // ("{ms}_{profesionalId}", una agenda por persona); sin equipo, solo la
    // hora (ver src/turnosOcupados.js).
    function idTurnoDe(cita, fechaHora) {
      return 'profesionalId' in cita
        ? idTurno(fechaHora) + '_' + cita.profesionalId
        : idTurno(fechaHora);
    }

    // Un turno (bloque de 20 min) es válido si cae dentro de la duración del
    // servicio de su cita: desde la hora de inicio hasta antes de terminar.
    // Así una cita de 50 min ocupa 10:00, 10:20 y 10:40, y como cada turno
    // solo puede tener una cita, nadie puede reservar encima (ver
    // src/turnosOcupados.js). El turno de inicio siempre vale.
    function turnoValido(negocioId, turno) {
      let datos = request.resource.data;
      let cita = citaTras(datos.citaId);
      let servicio = get(/databases/$(database)/documents/negocios/$(negocioId)/servicios/$(cita.servicioId)).data;
      return estaAutenticado()
        && datos.keys().hasOnly(['fechaHora', 'citaId'])
        && turno == idTurnoDe(cita, datos.fechaHora)
        && cita.negocioId == negocioId
        && (cita.fechaHora == datos.fechaHora
            || (datos.fechaHora > cita.fechaHora
                && datos.fechaHora < cita.fechaHora + duration.value(int(servicio.get('duracionMinutos', 20)), 'm')))
        && cita.estado != 'cancelada'
        && (cita.clienteId == request.auth.uid || esDueno(negocioId));
    }

    // La persona elegida en una cita existe en el equipo de ese negocio, está
    // activa, y el nombre guardado en la cita es el suyo.
    function profesionalDeCitaValido(datos) {
      let ruta = /databases/$(database)/documents/negocios/$(datos.negocioId)/profesionales/$(datos.get('profesionalId', '-'));
      return (!('profesionalId' in datos) && !('profesionalNombre' in datos))
        || (datos.profesionalId is string
            && exists(ruta)
            && get(ruta).data.get('activo', true) == true
            && datos.profesionalNombre == get(ruta).data.nombre);
    }

    function profesionalValido() {
      let datos = request.resource.data;
      return datos.nombre is string
        && datos.nombre.size() >= 2
        && datos.nombre.size() <= 40
        && textoMax(datos, 'cargo', 30)
        && datos.dias is list
        && datos.dias.size() <= 7
        && datos.activo is bool
        && imagenValida(datos, 'foto', 143360);
    }

    function resenaValida() {
      let datos = request.resource.data;
      return datos.calificacion is int
        && datos.calificacion >= 1
        && datos.calificacion <= 5
        && datos.comentario is string
        && datos.comentario.size() <= 500;
    }

    function textoMax(datos, campo, max) {
      return !(campo in datos) || (datos[campo] is string && datos[campo].size() <= max);
    }

    function listaMax(datos, campo, max) {
      return !(campo in datos) || (datos[campo] is list && datos[campo].size() <= max);
    }

    // Imagen recortada y comprimida en el navegador, guardada como data URL
    // (no hay Firebase Storage, ver src/imagenes.js). maxBytes es el tope del
    // texto: 140 KB para el logo, 650 KB para la portada.
    function imagenValida(datos, campo, maxBytes) {
      return !(campo in datos)
        || (datos[campo] is string
            && datos[campo].size() <= maxBytes
            && datos[campo].matches('data:image/(webp|jpeg|png);base64,[A-Za-z0-9+/=]+'));
    }

    function fotoPortafolioValida() {
      let datos = request.resource.data;
      return imagenValida(datos, 'imagen', 245760)
        && textoMax(datos, 'titulo', 60)
        && textoMax(datos, 'servicioId', 60)
        && (!('orden' in datos) || datos.orden is number);
    }

    function numeroEntre(datos, campo, min, max) {
      return datos[campo] is number && datos[campo] >= min && datos[campo] <= max;
    }

    function perfilValido() {
      let datos = request.resource.data;
      return textoMax(datos, 'nombre', 80)
        && textoMax(datos, 'correo', 120)
        && textoMax(datos, 'telefono', 20);
    }

    function correoDeRegistroPermitido() {
      return request.auth.token.firebase.sign_in_provider == 'google.com'
        || (request.auth.token.email is string
            && request.auth.token.email.lower().matches('^[^@]+@(gmail[.]com|googlemail[.]com|outlook[.]com|outlook[.]es|hotmail[.]com|hotmail[.]es|live[.]com|msn[.]com|yahoo[.]com|yahoo[.]es|ymail[.]com|icloud[.]com|me[.]com|mac[.]com)$'));
    }

    function negocioValido() {
      let datos = request.resource.data;
      return textoMax(datos, 'nombre', 80)
        && textoMax(datos, 'descripcion', 600)
        && textoMax(datos, 'direccion', 200)
        && textoMax(datos, 'correo', 120)
        && textoMax(datos, 'categoria', 60)
        && listaMax(datos, 'fotos', 30)
        && listaMax(datos, 'especialidades', 20)
        && listaMax(datos, 'metodosPago', 6)
        && imagenValida(datos, 'logo', 143360)
        && imagenValida(datos, 'miniatura', 61440)
        && textoMax(datos, 'fotoPrincipalId', 60)
        && (!('canalesContacto' in datos)
            || (textoMax(datos.canalesContacto, 'telefono', 20)
                && textoMax(datos.canalesContacto, 'whatsapp', 20)
                && textoMax(datos.canalesContacto, 'instagram', 30)
                && textoMax(datos.canalesContacto, 'tiktok', 30)));
    }

    function servicioValido() {
      let datos = request.resource.data;
      return textoMax(datos, 'nombre', 80)
        && textoMax(datos, 'descripcion', 300)
        && textoMax(datos, 'fotoUrl', 500)
        && numeroEntre(datos, 'precio', 0, 2000000)
        && numeroEntre(datos, 'duracionMinutos', 1, 480);
    }

    // Reseña verificada: el cliente indica una cita SUYA en este negocio, ya
    // pasada (su fecha y hora quedaron atrás) y no cancelada. No depende de
    // que el dueño la marque "completada" (muchos no lo harían); si el
    // cliente no llegó, el dueño cancela la cita y con eso ya no puede
    // reseñar con ella.
    function citaParaResena(negocioId) {
      let datos = request.resource.data;
      let cita = get(/databases/$(database)/documents/citas/$(datos.citaId)).data;
      return 'citaId' in datos
        && datos.citaId is string
        && cita.clienteId == request.auth.uid
        && cita.negocioId == negocioId
        && cita.fechaHora < request.time
        && cita.estado != 'cancelada';
    }

    function cambiosCita() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // Campos que cambia una edición. Al editar se limita QUÉ campos pueden
    // cambiar (no qué campos tiene el documento): así nadie agrega campos
    // basura a su propio documento, y los negocios creados con versiones
    // viejas de la app, que pueden tener algún campo extra, se siguen
    // pudiendo editar.
    function camposCambiados() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    function notificacionValida() {
      let datos = request.resource.data;
      return datos.keys().hasOnly(['tipo', 'titulo', 'texto', 'enlace', 'citaId', 'leida', 'creadoEn'])
        && datos.tipo in ['nueva-reserva', 'reserva-confirmada', 'cita-cancelada', 'recordatorio', 'calificar', 'nueva-resena', 'citas-hoy', 'citas-por-cerrar', 'perfil']
        && datos.titulo is string && datos.titulo.size() <= 80
        && datos.texto is string && datos.texto.size() <= 300
        && (!('enlace' in datos) || datos.enlace == null || (datos.enlace is string && datos.enlace.size() <= 120))
        && (!('citaId' in datos) || datos.citaId is string)
        && datos.leida == false
        && datos.creadoEn == request.time;
    }

    function avisoDeResena(uid) {
      return request.resource.data.tipo == 'nueva-resena'
        && existsAfter(/databases/$(database)/documents/negocios/$(uid)/resenas/$(request.auth.uid));
    }

    function avisoDeCita(uid) {
      let datos = request.resource.data;
      let cita = getAfter(/databases/$(database)/documents/citas/$(datos.citaId)).data;
      return (cita.clienteId == request.auth.uid && cita.negocioId == uid && datos.tipo in ['nueva-reserva', 'cita-cancelada'])
        || (cita.negocioId == request.auth.uid && cita.clienteId == uid && datos.tipo in ['cita-cancelada', 'calificar']);
    }

    // Ubicación del negocio: null o { lat, lng } con coordenadas válidas.
    function ubicacionValida(datos) {
      return !('ubicacion' in datos)
        || datos.ubicacion == null
        || (datos.ubicacion is map
            && datos.ubicacion.keys().hasOnly(['lat', 'lng'])
            && datos.ubicacion.lat is number && datos.ubicacion.lat >= -90 && datos.ubicacion.lat <= 90
            && datos.ubicacion.lng is number && datos.ubicacion.lng >= -180 && datos.ubicacion.lng <= 180);
    }

    match /usuarios/{uid} {
      allow read: if esDueno(uid)
                  || (estaAutenticado()
                      && resource.data.rol == 'cliente'
                      && exists(/databases/$(database)/documents/negocios/$(request.auth.uid)/clientes/$(uid)));
      allow create: if esDueno(uid)
                    && request.resource.data.rol in ['cliente', 'propietario']
                    && request.resource.data.keys().hasOnly(['rol', 'nombre', 'correo', 'telefono', 'consentimientoDatos', 'creadoEn', 'modoOscuro', 'modoOscuroPanel'])
                    && perfilValido()
                    && correoDeRegistroPermitido();
      allow update: if esDueno(uid)
                    && request.resource.data.rol == resource.data.rol
                    && camposCambiados().hasOnly(['nombre', 'correo', 'telefono', 'modoOscuro', 'modoOscuroPanel'])
                    && perfilValido();
      allow delete: if false;

      match /favoritos/{negocioId} {
        allow read, write: if esDueno(uid);
      }

      match /notificaciones/{notificacionId} {
        allow read, delete: if esDueno(uid);
        // La propia cuenta solo puede marcarla leída u ocultarla (la ✕ de
        // los avisos propios, ver eliminarNotificacion en notificaciones.js).
        allow update: if esDueno(uid)
                      && camposCambiados().hasOnly(['leida', 'oculta'])
                      && request.resource.data.leida is bool
                      && (!('oculta' in request.resource.data) || request.resource.data.oculta is bool);
        allow create: if estaAutenticado()
                      && notificacionValida()
                      && (esDueno(uid) || avisoDeResena(uid) || ('citaId' in request.resource.data && avisoDeCita(uid)));
      }
    }

    match /negocios/{negocioId} {
      allow read: if true;
      allow create: if esDueno(negocioId)
                    && rolDe(request.auth.uid) == 'propietario'
                    && request.resource.data.propietarioId == request.auth.uid
                    && request.resource.data.verificado == false
                    && negocioValido()
                    && ubicacionValida(request.resource.data);
      // verificado, propietarioId y creadoEn quedan fuera de la lista: no se
      // pueden cambiar al editar. La ubicación solo se valida si cambió: un
      // negocio guardado con otro formato igual puede editar su nombre u
      // horarios.
      allow update: if esDueno(negocioId)
                    && camposCambiados().hasOnly([
                         'nombre', 'descripcion', 'direccion', 'ubicacion', 'correo',
                         'canalesContacto', 'especialidades', 'horarios', 'fotos',
                         'logo', 'metodosPago', 'miniatura', 'fotoPrincipalId'
                       ])
                    && negocioValido()
                    && (!camposCambiados().hasAny(['ubicacion']) || ubicacionValida(request.resource.data));
      allow delete: if esDueno(negocioId);

      // Foto de portada, aparte del documento del negocio: pesa hasta 650 KB
      // y la vitrina descarga los documentos de todos los negocios; esta
      // solo se lee al abrir el portafolio de ese negocio.
      match /medios/{medioId} {
        allow read: if true;
        allow create, update: if esDueno(negocioId)
                              && medioId == 'portada'
                              && request.resource.data.keys().hasOnly(['imagen', 'actualizadoEn'])
                              && 'imagen' in request.resource.data
                              && imagenValida(request.resource.data, 'imagen', 665600);
        allow delete: if esDueno(negocioId);
      }

      // Fotos del portafolio subidas desde el panel: una por documento (hasta
      // 240 KB cada una), aparte del negocio por el mismo motivo que la
      // portada. El tope de 12 fotos lo controla el panel (las reglas no
      // pueden contar documentos).
      match /fotosPortafolio/{fotoId} {
        allow read: if true;
        allow create: if esDueno(negocioId)
                      && request.resource.data.keys().hasOnly(['imagen', 'titulo', 'servicioId', 'orden', 'creadoEn'])
                      && 'imagen' in request.resource.data
                      && fotoPortafolioValida();
        allow update: if esDueno(negocioId)
                      && camposCambiados().hasOnly(['titulo', 'servicioId', 'orden'])
                      && fotoPortafolioValida();
        allow delete: if esDueno(negocioId);
      }

      match /servicios/{servicioId} {
        allow read: if true;
        allow create: if esDueno(negocioId)
                      && request.resource.data.keys().hasOnly(['nombre', 'descripcion', 'precio', 'duracionMinutos', 'visible', 'fotoUrl'])
                      && servicioValido();
        allow update: if esDueno(negocioId)
                      && camposCambiados().hasOnly(['nombre', 'descripcion', 'precio', 'duracionMinutos', 'visible', 'fotoUrl'])
                      && servicioValido();
        allow delete: if esDueno(negocioId);
      }

      // Equipo del negocio (ver src/equipo.js): lo administra el dueño y lo
      // ve todo el mundo, porque el cliente elige con quién reservar.
      match /profesionales/{profesionalId} {
        allow read: if true;
        allow create: if esDueno(negocioId)
                      && request.resource.data.keys().hasOnly(['nombre', 'cargo', 'dias', 'activo', 'foto', 'creadoEn'])
                      && request.resource.data.creadoEn == request.time
                      && profesionalValido();
        allow update: if esDueno(negocioId)
                      && camposCambiados().hasOnly(['nombre', 'cargo', 'dias', 'activo', 'foto'])
                      && profesionalValido();
        allow delete: if esDueno(negocioId);
      }

      match /resenas/{resenaId} {
        allow read: if true;
        allow create: if esDueno(resenaId)
                      && rolDe(request.auth.uid) == 'cliente'
                      && request.resource.data.keys().hasOnly(['negocioId', 'clienteId', 'calificacion', 'comentario', 'creadoEn', 'citaId', 'nombreCliente'])
                      && request.resource.data.clienteId == request.auth.uid
                      && request.resource.data.negocioId == negocioId
                      && request.resource.data.creadoEn == request.time
                      && resenaValida()
                      && textoMax(request.resource.data, 'nombreCliente', 40)
                      && citaParaResena(negocioId);
        allow update: if esDueno(resource.data.clienteId)
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['calificacion', 'comentario'])
                      && resenaValida();
        allow delete: if esDueno(resource.data.clienteId);
      }

      match /clientes/{clienteId} {
        allow read: if esDueno(negocioId);
        allow create: if esDueno(negocioId)
                      && request.resource.data.keys().hasOnly(['citaId', 'resenaId', 'creadoEn'])
                      && (('citaId' in request.resource.data && citaDelCliente(negocioId, clienteId))
                          || ('resenaId' in request.resource.data && resenaDelCliente(negocioId, clienteId)));
        allow update, delete: if false;
      }

      match /ocupados/{turno} {
        allow read: if true;
        allow create: if turnoValido(negocioId, turno);
        allow update: if turnoValido(negocioId, turno)
                      && resource.data.citaId == request.resource.data.citaId;
        allow delete: if resource == null
                      || (esDueno(negocioId) && !('citaId' in resource.data))
                      || (estaAutenticado()
                          && citaTras(resource.data.citaId).negocioId == negocioId
                          && citaTras(resource.data.citaId).estado == 'cancelada'
                          && (citaTras(resource.data.citaId).clienteId == request.auth.uid || esDueno(negocioId)));
      }

      match /visitas/{clienteId} {
        allow read: if esDueno(clienteId) || esDueno(negocioId);
        allow create: if esDueno(clienteId) && rolDe(clienteId) == 'cliente';
        allow update, delete: if false;
      }
    }

    match /{path=**}/servicios/{servicioId} {
      allow read: if true;
    }

    match /{path=**}/resenas/{resenaId} {
      allow read: if true;
    }

    match /citas/{citaId} {
      allow read: if estaAutenticado()
                  && (resource.data.clienteId == request.auth.uid
                      || resource.data.negocioId == request.auth.uid);
      // El cliente solo puede cancelar su cita. El negocio puede cambiarla entre
      // reservada (pendiente), cancelada y realizada (completada), pero
      // "realizada" solo cuando ya llegó la hora de la cita.
      allow update: if (esDueno(resource.data.clienteId)
                        && cambiosCita().hasOnly(['estado', 'canceladaPor'])
                        && request.resource.data.estado == 'cancelada'
                        && request.resource.data.canceladaPor == 'cliente')
                    || (esDueno(resource.data.negocioId)
                        && cambiosCita().hasOnly(['estado', 'canceladaPor'])
                        && request.resource.data.estado in ['pendiente', 'cancelada', 'completada']
                        && (request.resource.data.estado != 'completada'
                            || resource.data.estado == 'completada'
                            || resource.data.fechaHora <= request.time)
                        && (!cambiosCita().hasAny(['canceladaPor'])
                            || request.resource.data.canceladaPor == 'negocio'));
      allow create: if estaAutenticado()
                    && rolDe(request.auth.uid) == 'cliente'
                    && request.resource.data.keys().hasOnly(['negocioId', 'clienteId', 'servicioId', 'fechaHora', 'estado', 'creadoEn', 'profesionalId', 'profesionalNombre'])
                    && request.resource.data.clienteId == request.auth.uid
                    && request.resource.data.estado == 'pendiente'
                    && request.resource.data.fechaHora is timestamp
                    && request.resource.data.fechaHora > request.time
                    && request.resource.data.creadoEn == request.time
                    && exists(/databases/$(database)/documents/negocios/$(request.resource.data.negocioId)/servicios/$(request.resource.data.servicioId))
                    && profesionalDeCitaValido(request.resource.data)
                    && getAfter(/databases/$(database)/documents/negocios/$(request.resource.data.negocioId)/ocupados/$(idTurnoDe(request.resource.data, request.resource.data.fechaHora))).data.citaId == citaId;
      allow delete: if false;
    }
  }
}
