{
  "name": "minibarrio-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "MiniBarrio — Prototipo de plataforma digital de portafolio comercial y recomendación para barberías del barrio Britalia (Trabajo de Grado, Ingeniería de Sistemas, Universidad Católica de Colombia).",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext js,jsx --report-unused-disable-directives --max-warnings 0",
    "test": "node --test \"src/**/*.test.js\"",
    "test:reglas": "firebase emulators:exec --only firestore --project demo-minibarrio \"node --test tests/reglas/\""
  },
  "dependencies": {
    "firebase": "^11.0.2",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^8.57.1",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.14",
    "firebase-tools": "^14.27.0",
    "vite": "^5.4.11"
  }
}
