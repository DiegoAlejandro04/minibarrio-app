# Copia este archivo como ".env" (sin ".example") y completa con los valores
# reales de tu proyecto de Firebase. NUNCA subas el archivo ".env" al repositorio
# (ya está ignorado en .gitignore).
#
# Los valores se obtienen en: Firebase Console > Configuración del proyecto >
# Tus apps > SDK setup and configuration > Config.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
